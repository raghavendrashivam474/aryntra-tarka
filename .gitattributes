# Aryntra Tarka - Git Attributes
# Normalise line endings to LF in the repository
# Git will handle conversion on checkout per platform

* text=auto eol=lf

# Python source files
*.py text eol=lf

# Config and data files
*.txt text eol=lf
*.md text eol=lf
*.env text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf

# Windows scripts
*.ps1 text eol=crlf
*.bat text eol=crlf